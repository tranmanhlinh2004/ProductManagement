# Local development: SQL Server default instance, Windows Authentication.
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=localhost
DB_NAME=QLSP_Barcode
DB_TRUSTED_CONNECTION=yes

# Used only when DB_TRUSTED_CONNECTION=no (SQL Server Authentication).
# These credentials belong to SQL Server, not the application's users table.
DB_USER=
DB_PASSWORD=

DB_ENCRYPT=yes
# yes is for a local development server with a self-signed certificate only.
# Use no with a trusted certificate when deploying.
DB_TRUST_SERVER_CERTIFICATE=yes
DB_CONNECT_TIMEOUT=5
DB_QUERY_TIMEOUT=15
