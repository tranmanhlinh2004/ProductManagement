{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ProductManagement: Start backend",
      "type": "process",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "args": ["-u", "run.py"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": {
        "owner": "productmanagement-backend",
        "pattern": {
          "regexp": "^\\s*File \"(.+)\", line (\\d+)(.*)$",
          "file": 1,
          "line": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^ \\* Serving Flask app",
          "endsPattern": "^ \\* Running on http://127\\.0\\.0\\.1:8080"
        }
      }
    }
  ]
}
